# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Generate each secret with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRES_MINUTES=60

# SQLite (default). For MySQL later:  mysql+pymysql://user:password@localhost/aura_task_db
# DATABASE_URL=

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

MAX_CODE_BYTES=50000
MAX_CODE_LINES=2000
